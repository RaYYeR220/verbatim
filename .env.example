# Model for the in-app agent: set one provider key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=          # any OpenAI-compatible endpoint
# AGENT_ENGINE=ai-sdk:openai
# AGENT_MODEL=claude-sonnet-5-5

# Local development: skip sign-in and act as a dev user.
AUTH_DISABLED=true
AGENT_USER_EMAIL=dev@local.test

# Production
# DATABASE_URL=              # PostgreSQL (local dev uses PGlite when unset)
# BETTER_AUTH_SECRET=
# GUEST_SESSION_SECRET=      # signs one-click guest workspaces
# DEMO_STUDY_IDS=            # studies copied into each guest workspace
# GUEST_AGENT_RUNS_PER_DAY=30
# GUEST_AGENT_RUNS_TOTAL_PER_DAY=600
# CRON_SECRET=
# A2A_SECRET=
